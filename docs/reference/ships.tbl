; https://discord.com/channels/664864495037972481/949387359219236894/1040000299529670776

  ;;first/leader spot is 0,0,0

  $Name: Y Box
    ;((0.00, 0.00, 0.00)
    ((0.50, 0.00, 0.00)
    ( 0.00, 0.50, -0.50) 
