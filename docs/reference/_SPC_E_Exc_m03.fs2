$label:  XSTR("Bilbringi 9", 1479)
+id: 11
$hlight: 0
$mirror: 0
$multi_text
$end_multi_text
$end_icon
$end_stage
$start_stage
$multi_text
 XSTR("While some of the shipping moving through $y Bilbringi $y 9 is legitimate, several potential targets docked at the supply depot have already been identified.  Ships that power down immediately will be inspected, but we are not interested in those that have nothing to hide.  Any vessels that flee are criminals at best and more likely $h Rebels$|.", 1480)
$end_multi_text
$voice: l1_M3_b2.ogg
$camera_pos: 2004.665527, 7772.857422, 7390.095215
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, -0.000065, 1.000000,
	0.000000, -1.000000, -0.000065
$camera_time: 2000
