#Debriefing_info

$Num stages: 8

$Formula: ( not 
   ( is-event-true-delay 
      "Alpha 1 Traitor" 
      0 
   )
)
$Multi text
    XSTR("In a typical act of desperation and cowardice, the Rebels cornered in the fueling station overloaded the facility's reactor rather than risking capture.  The resulting explosion killed thousands of workers, and it was only thanks to the scanning equipment sent in with the stormtrooper force that we were able to withdraw our men in time.", 1488)
$end_multi_text
$Voice: I1_M3_db1.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( and 
   ( = @NumTagged[0] 3 ) 
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("In spite of these terrorist acts, Alpha 1 distinguished himself today.  All three of the critical black market vessels are now transmitting clear signals, and will provide valuable information on the Rebel supply chains.", 1489)
$end_multi_text
$Voice: I1_M3_db2.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( and 
   ( > @NumTagged[0] 0 ) 
   ( != @NumTagged[0] 3 ) 
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("Although Alpha 1 was unable to tag all three critical freighters before they could make the jump to lightspeed, we have acquired enough information to begin tracing the Rebel supply chains.", 1490)
$end_multi_text
$Voice: I1_M3_db3.ogg
$Recommendation text:
    XSTR("Tagging Tayana Star, Zaltin 12, and Sulonan should be your highest priority.  Divert power to engines if needed.", 1491)
$end_multi_text

$Formula: ( and 
   ( = @NumTagged[0] 0 ) 
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("As Alpha 1 failed to tag any of the escaping freighters, we will have no way of bringing these criminals to justice.  Lord Vader will soon be visiting the site of the attack, and he will not be pleased with this performance.  He is a most creative man when it comes to finding ways to motivate his officers.", 1492)
$end_multi_text
$Voice: I1_M3_db4.ogg
$Recommendation text:
    XSTR("Tagging Tayana Star, Zaltin 12, and Sulonan should be your highest priority.  Divert power to engines if needed.", 1491)
$end_multi_text

$Formula: ( and 
   ( percent-ships-destroyed 
      5 
      "Charmed" 
      "Ulabos Ringer" 
      "Blue Mountain Drifter" 
      "Tayana Star" 
      "Night Bloom" 
      "Sulonan" 
      "Zaltin 12" 
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("Regrettably, our wing was unable to prevent the destruction of unarmed vessels during this engagement.  Greater restraint is required in dealing with civilians, even criminals.  We are soldiers, not butchers.", 1493)
$end_multi_text
$Voice: I1_M3_db5.ogg
$Recommendation text:
    XSTR("Make sure any deployed flights have orders to disable or ignore the secondary objective freighters.  Even with explicit disable orders, your overzealous pilots may accidentally destroy a target ship if they are not positioned to attack from the aft quarter.", 1494)
$end_multi_text

$Formula: ( and 
   ( is-event-true-delay 
      "Tau Does Something" 
      0 
   )
   ( not 
      ( is-event-true-delay "Tau Blasted" 0 ) 
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("Although this was a dark day for the Empire, congratulations are in order for Tau Squadron, who performed admirably in their first combat.  Your bravery is a credit to the entire wing.", 1495)
$end_multi_text
$Voice: I1_M3_db6.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( not 
   ( is-event-true-delay 
      "Alpha 1 Traitor" 
      0 
   )
)
$Multi text
    XSTR("It may be some time before we can bring peace to the victims of Bilbringi, but I assure you we will make the Rebel scum pay for what they have done here.  Dismissed.", 1496)
$end_multi_text
$Voice: I1_M3_db7.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( is-event-true-delay 
   "Alpha 1 Traitor" 
   0 
)
$Multi text
    XSTR("You have been found guilty of the crime of treason against the Emperor, and are to be executed immediately.  This betrayal is particularly disappointing coming from such a gifted and well-bred individual.  You have not only failed yourself, your fleet, and your Emperor, but your family too will lose everything.  Be thankful that the circumstances of our deployment have spared you from Lord Vader's tender mercies.  You have one hour to prepare yourself.", 1443)
$end_multi_text
$Voice: I1_Traitor.ogg
$Recommendation text:
    XSTR("Refrain from shooting friendly targets.", 1497)
$end_multi_text

