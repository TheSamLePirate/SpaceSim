#Command Briefing

#Briefing
$start_briefing
$num_stages: 5
$start_stage
$multi_text
 XSTR("Our stormtrooper transports have been recalled and $f Convictor is moving into position to lock down the area.  We expect many ships will attempt to flee the system, and we intend to use the chaos this produces to our advantage.", 1477)
$end_multi_text
$voice: l1_M3_b1.ogg
$camera_pos: 0.000000, 12870.666016, 7551.539062
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, -0.000065, 1.000000,
	0.000000, -1.000000, -0.000065
$camera_time: 2000
