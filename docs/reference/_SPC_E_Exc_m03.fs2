$end_stage
$start_stage
$multi_text
 XSTR("Of particular interest are the light freighters $n Tayana $n Star$|, $n Zaltin $n 12$|, and $n Sulonan$|.  These vessels are to be tagged with homing beacons and allowed to escape, though superficial damage would help make the pursuit look convincing.  As our most experienced pilot, $f Alpha $f 1 will fly the bomber that will tag the freighters.", 1481)
$end_multi_text
$voice: l1_M3_b3.ogg
$camera_pos: 4263.110352, 10030.731445, 8602.448242
$camera_orient:
	1.000000, 0.000000, 0.000000,
