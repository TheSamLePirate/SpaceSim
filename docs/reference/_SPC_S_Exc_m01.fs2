#Debriefing_info

$Num stages: 8

$Formula: ( not 
   ( is-destroyed-delay 0 "Tayana Star" ) 
)
$Multi text
    XSTR("We're doomed.  I estimate that at least two thousand organics and three hundred droids perished in the explosion that forced us to flee the system.  The Empire surely obtained sensor readings of our craft as we made our escape.  They will soon be seizing our assets on Duro and gathering information from all of our known contacts.  We will have to change all of our registries and move our operations beyond their reach if we hope to remain solvent.", 2185)
$end_multi_text
$Voice: S1_M1_db1.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( and 
   ( not 
      ( is-destroyed-delay 0 "Tayana Star" ) 
   )
   ( not 
      ( is-event-true-delay 
         "TS Hull Critical" 
         0 
      )
   )
)
$Multi text
    XSTR("On the other hand, these events may have opened new opportunities for us.  As only two other ships were able to escape the area, our sensor data could be extremely valuable to the Rebellion in establishing an independent account of these events.  I am aware of your reluctance to join their cause, and I agree that they have little chance of success against the Empire, but for the time being, they may be our best and most reliable business partners.", 2186)
$end_multi_text
$Voice: S1_M1_db2.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( and 
   ( not 
      ( is-destroyed-delay 0 "Tayana Star" ) 
   )
   ( not 
      ( is-event-true-delay "TS Hull 45" 0 ) 
   )
   ( is-event-true-delay "TS Hull 70" 0 ) 
)
$Multi text
    XSTR("", -1)
$end_multi_text
$Voice: none.wav
$Recommendation text:
    XSTR("Tayana Star sustained moderate damage which will be costly to repair, but it could have been significantly worse (current hull integrity is $TS_Hull).  The greatest threat to her hull is Alpha Group, including TIE Bomber Alpha 1, at the beginning of the mission, then the incoming asteroids and Epsilon Group once she reaches the debris field.", 2187)
$end_multi_text

$Formula: ( and 
   ( not 
      ( is-destroyed-delay 0 "Tayana Star" ) 
   )
   ( not 
      ( is-event-true-delay 
         "TS Hull Critical" 
         0 
      )
   )
   ( is-event-true-delay "TS Hull 45" 0 ) 
)
$Multi text
    XSTR("", -1)
$end_multi_text
$Voice: none.wav
$Recommendation text:
    XSTR("Tayana Star sustained heavy damage which will be very costly to repair (current hull integrity is $TS_Hull).  She will make it to Ledos, but you lost a lot of money today.  The greatest threat to her hull is Alpha Group, including TIE Bomber Alpha 1, at the beginning of the mission, then the incoming asteroids and Epsilon Group once she reaches the debris field.", 2188)
$end_multi_text

$Formula: ( and 
   ( not 
      ( is-destroyed-delay 0 "Tayana Star" ) 
   )
   ( not 
      ( is-event-true-delay "TS Hull 70" 0 ) 
   )
)
$Multi text
    XSTR("Judging by the amount of fuel we have moved for them in recent months, I believe that the Alliance was acquiring much of their hypermatter from the Bilbringi facility.  As this source will no longer be available, fuel from our contacts within Hutt Space may fetch excellent prices.", 2189)
$end_multi_text
$Voice: S1_M1_db3.ogg
$Recommendation text:
    XSTR("Tayana Star escaped Bilbringi in excellent condition considering the circumstances, well done (current hull integrity is $TS_Hull).", 2190)
$end_multi_text

$Formula: ( and 
   ( not 
      ( is-destroyed-delay 0 "Tayana Star" ) 
   )
   ( is-event-true-delay 
      "TS Hull Critical" 
      0 
   )
)
$Multi text
    XSTR("It is my sad duty to report that due to the damage we have sustained, Tayana Star will have to be sold for scrap.  Repairing our damage will cost far beyond what we could hope to recover from our current contracts, and the ship will not last more than one or two jumps.

Our only option at the moment is to take the merchandise in our cargo bays and look for third-party buyers.  We most certainly will not make what the units are worth, and we will not be able to deal with the Alliance in the future, but it may be enough to allow us to begin again in Hutt Space.", 2191)
$end_multi_text
$Voice: S1_M1_db4.ogg
$Recommendation text:
    XSTR("You must keep Tayana Star's hull in good condition in order to pass this mission.  The greatest threat to her hull is Alpha Group, including TIE Bomber Alpha 1, at the beginning of the mission, then the incoming asteroids and Epsilon Group once she reaches the debris field.", 2192)
$end_multi_text

$Formula: ( is-destroyed-delay 0 "Tayana Star" ) 
$Multi text
    XSTR("I'm sorry about the Star, Emora, I know how much she meant to you.  The Commodore isn't happy about this, but we can still use your help.  We've been trying to get your people off of $y Duro$|, but it's not gonna be easy.  Let me know if you change your mind about my offer.  The Rebellion needs pilots like you, and it's not like you've got a lot of profitable avenues left to explore.  Take care-

-Avon Du'Elo", 2193)
$end_multi_text
$Voice: S1_M1_db5.ogg
$Recommendation text:
    XSTR("You must keep Tayana Star alive and in good condition in order to pass this mission.  The greatest threat to her hull is Alpha Group, including TIE Bomber Alpha 1, at the beginning of the mission, then the incoming asteroids and Epsilon Group once she reaches the debris field.", 2194)
$end_multi_text

$Formula: ( true ) 
$Multi text
    XSTR("", -1)
$end_multi_text
$Voice: none.wav
$Recommendation text:
    XSTR("The current hull integrity of your N-1 Starfighter is $Player_Hull.", 2195)
$end_multi_text

