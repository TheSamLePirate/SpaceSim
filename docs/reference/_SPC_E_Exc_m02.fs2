$multi_text
$end_multi_text
$end_icon
$start_icon
$type: 27
$team: Friendly
$class: DX-9 Stormtrooper Transport
$pos: 3565.210693, -499.998596, 3180.790039
$label:  XSTR("Delta", 1430)
+id: 3
$hlight: 1
$mirror: 0
$use wing icon: 1
$multi_text
$end_multi_text
$end_icon
$end_stage
$start_stage
$multi_text
 XSTR("It will take several hours for our stormtrooper squads to fully pacify and inspect the facility.  Any ships attempting to depart the asteroid could compromise the mission and are to be considered valid targets.  It is absolutely vital that all three $f Delta-class transports reach their destination unharmed.  $f Gamma and $f Epsilon Squadrons will be prepared to launch should you encounter determined resistance.", 1431)
$end_multi_text
$voice: l1_M2_b3.ogg
$camera_pos: 74.051498, 25686.982422, 17221.468750
$camera_orient:
	0.082205, -0.000000, 0.996615,
	-0.996419, 0.019834, 0.082189,
	-0.019767, -0.999803, 0.001630
