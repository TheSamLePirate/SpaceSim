#Command Briefing

$Stage Text:
 XSTR("$f Supply $f Interdiction

Imperial Intelligence has revealed that the $y Bilbringi $y 9 hypermatter processing facility has been supplying the $h Rebellion with fuel and materials.  Our next series of operations will put an end to this treason and allow us to identify and directly trace key $h Rebel supply lines.  We will then root out our enemies cell by cell.  Lieutenant Grilner will brief you on the details of your assignment.", 1425)
$end_multi_text
$Ani Filename: CB_imp
+Wave Filename: I1_M2_cb1.ogg

#Briefing
$start_briefing
$num_stages: 4
$start_stage
$multi_text
 XSTR("The $y Bilbringi $y 9 facility is comprised of an asteroid-based hypermatter processing plant and a more heavily trafficked supply depot in synchronous orbit.  $f Convictor is scheduled to take on fuel before conducting fleet exercises in the system's testing grounds.  This will provide cover for our actions.", 1426)
$end_multi_text
$voice: l1_M2_b1.ogg
$camera_pos: -425.803162, 60136.644531, 231.693466
$camera_orient:
	-0.080615, 0.000000, 0.996745,
	-0.996745, -0.000000, -0.080615,
	0.000000, -1.000000, 0.000000
$camera_time: 2000
$num_lines: 0
$num_icons: 2
$Flags: 0
$Formula: ( true ) 
$start_icon
$type: 15
$team: Civilian
$class: Asteroid Base
$pos: 693.427063, 0.000496, 16184.509766
$label:  XSTR("Hypermatter Processing", 1427)
+id: 1
$hlight: 0
$mirror: 0
$multi_text
$end_multi_text
$end_icon
$start_icon
$type: 15
$team: Civilian
$class: XQ2 Platform#Reb
$pos: 845.831909, -0.001659, -16732.486328
$label:  XSTR("Supply Depot", 1428)
+id: 5
$hlight: 0
$mirror: 0
$multi_text
$end_multi_text
$end_icon
$end_stage
$start_stage
$multi_text
 XSTR("While interposed between the two installations, we will launch a strike force to take and hold the asteroid facility.  $f Convictor will jam emergency communications from the plant until the strike team can secure the traffic control room.", 1429)
$end_multi_text
$voice: l1_M2_b2.ogg
$camera_pos: -651.951843, 37564.394531, 6371.705078
$camera_orient:
	-0.026720, -0.000000, 0.999643,
	-0.999240, -0.028381, -0.026709,
	0.028371, -0.999597, 0.000758
$camera_time: 2000
$num_lines: 0
