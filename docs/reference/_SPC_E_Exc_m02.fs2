#Debriefing_info

$Num stages: 7

$Formula: ( and 
   ( is-event-true-delay 
      "Abort - coded msg sent" 
      0 
   )
   ( not 
      ( percent-ships-destroyed 
         33 
         "Delta 1" 
         "Delta 2" 
         "Delta 3" 
      )
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("This should have been a simple operation.  The Rebel resistance and interference from the Port Authority had been anticipated, and adequate resources were on hand to deal with the threat they posed.  Catastrophic failures like this are the reason fleet officers are hesitant to delegate command responsibility to pilots.  With luck, the disciplinary committee will be lenient.  It was a pleasure serving with you, sir.", 1435)
$end_multi_text
$Voice: l1_M2_db1.ogg
$Recommendation text:
    XSTR("Send a wing to destroy or disable one of the escaping Rebel transports while you handle the other personally.  Epsilon wing has a more powerful primary armament than your other squadrons, while Gamma is faster.", 1436)
$end_multi_text

$Formula: ( and 
   ( percent-ships-destroyed 
      33 
      "Delta 1" 
      "Delta 2" 
      "Delta 3" 
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("This should have been a simple operation.  The Rebel resistance and interference from the Port Authority had been anticipated, and adequate resources were on hand to deal with the threat they posed.  Catastrophic failures like this are the reason fleet officers are hesitant to delegate command responsibility to pilots.  With luck, the disciplinary committee will be lenient.  It was a pleasure serving with you, sir.", 1435)
$end_multi_text
$Voice: l1_M2_db1.ogg
$Recommendation text:
    XSTR("Do not leave the transports unguarded under any circumstances.  Gamma and Epsilon wings are available.", 1437)
$end_multi_text

$Formula: ( and 
   ( is-event-true-delay 
      "Mission complete" 
      0 
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("The stormtrooper insertion was a success, and the upper levels of the facility have been secured.  Our discovery of Rebel activity and the Port Authority's collusion in black market affairs have confirmed our suspicions, and Convictor's support ships have been deployed throughout the system to monitor traffic.  To outside observers, the events of the past half hour have been reported as a fueling accident, and the station has been quarantined until the automated cleanup sequence is completed.", 1438)
$end_multi_text
$Voice: l1_M2_db2.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( and 
   ( is-event-true-delay 
      "Mission complete" 
      0 
   )
   ( is-event-true-delay 
      "1 BilPA escaped" 
      0 
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("You were unable to fully control the situation with the Port Authority.  Fortunately, those ships that escaped were reported rogue and taken by assets deployed from Bilbringi 7.  While this reflects poorly on you as wing commander, our operations have not been compromised.", 1439)
$end_multi_text
$Voice: l1_M2_db3.ogg
$Recommendation text:
    XSTR("Speed is key when dealing with the Port Authority fighters.", 1440)
$end_multi_text

$Formula: ( and 
   ( is-event-true-delay 
      "Mission complete" 
      0 
   )
   ( is-event-false-delay 
      "1 BilPA escaped" 
      0 
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("Your response to the Port Authority fighters was particularly impressive.  Keeping a group of hyperspace-capable fighters contained is no small feat, and the bridge took notice.", 1441)
$end_multi_text
$Voice: l1_M2_db4.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( and 
   ( is-event-true-delay 
      "Mission complete" 
      0 
   )
   ( not 
      ( is-event-true-delay 
         "Alpha 1 Traitor" 
         0 
      )
   )
)
$Multi text
    XSTR("Immolator's squadrons are presently on combat patrol.  Once the fueling station is fully secured, Alpha will be redeployed and we will move on the supply depot.", 1442)
$end_multi_text
$Voice: l1_M2_db5.ogg
$Recommendation text:
    XSTR("", -1)
$end_multi_text

$Formula: ( is-event-true-delay 
   "Alpha 1 Traitor" 
   0 
)
$Multi text
    XSTR("You have been found guilty of the crime of treason against the Emperor, and are to be executed immediately.  This betrayal is particularly disappointing coming from such a gifted and well-bred individual.  You have not only failed yourself, your fleet, and your Emperor, but your family too will lose everything.  Be thankful that the circumstances of our deployment have spared you from Lord Vader's tender mercies.  You have one hour to prepare yourself.", 1443)
$end_multi_text
$Voice: I1_Traitor.ogg
$Recommendation text:
    XSTR("Refrain from firing on friendly targets.", 1444)
$end_multi_text

