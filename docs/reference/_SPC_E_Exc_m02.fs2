$end_icon
$end_stage
$start_stage
$multi_text
 XSTR("We have reason to believe that elements of the $y Bilbringi $y Port $y Authority are collaborating with the $h Rebels to hide their activities.  If they attempt to interfere with the operation, you are authorized to take any steps necessary to ensure that they do not succeed in warning the $h Rebels at the supply depot.  Alpha will launch as soon as we are in position.", 1433)
$end_multi_text
$voice: l1_M2_b4.ogg
$camera_pos: 72758.484375, 25323.671875, -25562.558594
$camera_orient:
	0.446808, -0.000001, 0.894630,
