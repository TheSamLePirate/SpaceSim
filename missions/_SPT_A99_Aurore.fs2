#Command Briefing

#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("Red 1, vous escortez le transport rebelle Aurore, charge de materiel medical.

Deux chasseurs TIE se rapprochent par l'avant. Detruisez-les avec l'aide de Red 2 et gardez Aurore en vie. Le transport attend que la route soit libre avant de passer en hyperespace.

La mission se terminera automatiquement apres son depart. Aucun retour manuel n'est necessaire.", -1)
$end_multi_text
$voice: none.wav
$camera_pos: 0.000000, 3000.000000, -2500.000000
$camera_orient:
 1.000000, 0.000000, 0.000000,
 0.000000, 0.707107, 0.707107,
 0.000000, -0.707107, 0.707107
$camera_time: 500
$num_lines: 0
$num_icons: 0
$Flags: 0
$Formula: ( true )
$end_stage
$end_briefing

#Debriefing_info
$Num stages: 2
$Formula: ( has-departed-delay 0 "Aurore" )
$Multi text
 XSTR("Mission accomplie. Aurore a rejoint la flotte avec sa cargaison medicale. Les deux TIE ont ete neutralises. Belle premiere escorte, Red 1.", -1)
$end_multi_text
$Voice: none.wav
$Recommendation text:
 XSTR("Pour modifier cette mission dans FRED : deplacez les TIE, ajoutez un ennemi ou changez les objectifs dans les editeurs.", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Aurore" )
$Multi text
 XSTR("Echec de l'escorte. Aurore a ete detruit. Recommencez et interceptez rapidement les TIE avant qu'ils ne concentrent leurs tirs sur le transport.", -1)
$end_multi_text
$Voice: none.wav
$Recommendation text:
 XSTR("Restez pres du transport et concentrez vos tirs sur un TIE a la fois. Red 2 vous accompagne.", -1)
$end_multi_text

