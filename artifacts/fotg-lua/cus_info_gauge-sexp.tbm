#Lua SEXPs

$Operator: role-gauge-set-title
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 1
$Maximum Arguments: 1
$Return Type: Nothing
$Description: Sets the title of the object role gauge to the specified string. Note, does not work in multiplayer. 
$Parameter: 
	+Description: Title of gauge.
	+Type: String

$Operator: role-gauge-add-object
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 2
; No maximum arguments means that it accepts a variable number of arguments
$Return Type: Nothing
$Description: Adds the specified object and role description to the list of object roles displayed. Note, does not work in multiplayer.
$Repeat
$Parameter: 
	+Description: Object to add to the object role gauge.
	+Type: String
$Parameter: 
	+Description: Object role description.
	+Type: String

$Operator: role-gauge-update-object
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 2
; No maximum arguments means that it accepts a variable number of arguments
$Return Type: Nothing
$Description: Updates the specified object and role description. Will not do anything if the object is not present. Note, does not work in multiplayer.
$Repeat
$Parameter: 
	+Description: Object to update in the object role gauge.
	+Type: String
$Parameter: 
	+Description: New object role description.
	+Type: String

$Operator: role-gauge-update-object-num
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 2
; No maximum arguments means that it accepts a variable number of arguments
$Return Type: Nothing
$Description: Updates the specified object and role description using a number. Will not do anything if the object is not present. Note, does not work in multiplayer.
$Repeat
$Parameter: 
	+Description: Object to update in the object role gauge.
	+Type: String
$Parameter: 
	+Description: New object role description.
	+Type: Number	

$Operator: role-gauge-remove-object
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 1
; No maximum arguments means that it accepts a variable number of arguments
$Return Type: Nothing
$Description: Removes the specified object from the list of object roles displayed. Note, does not work in multiplayer.
$Repeat
$Parameter: 
	+Description: Object to remove from the object role gauge.
	+Type: String
	
$Operator: role-gauge-clear-all
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 0
$Maximum Arguments: 0
$Return Type: Nothing
$Description: Removes all objects from the object roles gauge. Note, does not work in multiplayer.

$Operator: role-gauge-toggle
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 1
$Maximum Arguments: 2
$Return Type: Nothing
$Description: Toggles the object role gauge. Optional second boolean specifies if the visibility status of the object role gauge is tied to the visibility status of the directives gauge (defaults to false, or role gauge will always display even if directives gauge is off). Note, does not work in multiplayer.
$Parameter: 
	+Description: Gauge toggle, true for on, false for off. 
	+Type: Boolean
$Parameter: 
	+Description: Is gauge visibility tied to visibility of directives gauge. True if visibility is linked--in other words, object role gauge can be turned off by turning off directives gauge. False (default) if visibility is unaffected--in other words, object role gauge cannot be turned off by player, which is useful for mission critical instructions.  
	+Type: Boolean

$Operator: role-gauge-set-separator
$Category: Change
$Subcategory: LUA-Custom Role Gauge
$Minimum Arguments: 1
$Maximum Arguments: 1
$Return Type: Nothing
$Description: String to use as the separator between the object name and object description in the object roles gauge. The default is ": ". Note, does not work in multiplayer.
$Parameter: 
	+Description: String to use as the separator. 
	+Type: String

#End