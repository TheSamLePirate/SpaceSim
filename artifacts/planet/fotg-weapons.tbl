#Countermeasures

	; NOTES:
	;  https://wiki.hard-light.net/index.php/Weapons.tbl#.24Countermeasure:
	;  Other notes listed throughout this entry. Also recall there is the countermeasures script. 

$Name:	Ion Discharge CM
	;;-also recall that `AI Countermeasure Firing Chance` in ai.tbl and `countermeasures-sct.tbm` exists
	@Laser Bitmap:                null_effect_0000
	@Laser Glow:                  null_effect_0000
	@Laser Color:                 20, 20, 240
	@Laser Color2:                20, 20, 240
	@Laser Length:                0.0
	@Laser Head Radius:           0.0
	@Laser Tail Radius:           0.0
	$Light Radius:			      0.0 ;;;
	$Light Intensity:			  0.0 ;;;
	$Velocity:				0.0 
	$Fire Wait:				0.1
	$Lifetime Min:			2.5 
	$Lifetime Max:			2.5 
	$LaunchSnd:				100 ;jamming sound 
	;$Model:                seismic.pof
	$Flags:					( "countermeasure" "same turret cooldown" "detonate on expiration" )
	$Icon:						  icon_default
	; "pulls aspect seekers" = If an aspect seeker is grabbed by this countermeasure the missile will follow the countermeasure instead of going into dumbfire mode.
	; if using detontation then it looks very odd to the player, of why their missile seems to have hit but done very little damage
	$Countermeasure:
		+Heat Effectiveness:		1.0
		+Aspect Effectiveness:		1.0
		+Effective Radius:			150.0
		+Missile Detonation Radius: 30.0 ;only applicable to (heat) or (aspect if "pulls aspect seekers" flag used) 
		;^keep within missile damage radius so even decoyed warheads may do some damage and make targeted craft evade..
		;..ideally CM is still farther away then where parent ship is, too
		+Launch Vector: 0, 0, -1
		+Launch Speed: 25
		+Launch Variance: 0
		+Single Missile Kill:		false ;only applicable if (heat) or ("pulls aspect seekers" flag used), 
		;^if CM detonates the warhead it decoyed, then all warheads within detonation radius die
		+Pulse Interval:			50 ;;in milliseconds, 0 disables pulse and uses old, weird style
		+Use Fire Wait:
		+Failure Launch Delay Multiplier for AI:	1
		+Successful Launch Delay Multiplier for AI:	10 ;;this makes the firewait 0.1, which might make AI save remaining CMs if it used the first one effectively 

#End

