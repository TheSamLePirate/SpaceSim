	$Lifetime Curve:
		+Input: Apparent Size
		+Output: Laser Animation State
		+Curve Name: C_Laser_Size_Anim_B
	$Energy Consumed: 			  3.0
	$Cargo Size: 				  0.0
	$Homing: 					  NO
	$LaunchSnd:                   260 ;turbo-medium red launch
	$ImpactSnd:                   271 ;turbo-medium impact
	$FlyBySnd:					  226 ;;turbo flyby
	+Weapon Range:				  2500 ;turbo-medium range (A)
	$Flags:                       ( "in tech database" "no_fred" )
	$Icon:						  icon_default
	$Impact Effect:				  PE_Hit_Flash_Laser
	$Conditional Impact:
		+Armor Type: Starfighter_Shield_Armor
